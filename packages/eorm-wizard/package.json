{
  "name": "eorm-wizard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Assistent zum Erzeugen von eorm-Mappings (EMF → JPA) für emf.persistence-jpa",
  "scripts": {
    "dev": "vite --port 5599 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "generate": "emfts-codegen generate -m model/eorm-wizard.ecore -c model/eorm-wizard.genconfig.xmi",
    "build:plugin": "node scripts/build-plugin.mjs",
    "serve:plugin": "npx serve dist/plugins -l 5499 --cors",
    "mock:atlas": "node scripts/mock-atlas.mjs",
    "sync:eorm-model": "cp ../../dim_xdp/emf.persistence-jpa/org.eclipse.fennec.persistence.orm/model/eorm.ecore src/assets/eorm.ecore && cp ../../dim_xdp/emf.persistence-jpa/org.eclipse.fennec.persistence.orm/model/epersistence.ecore src/assets/epersistence.ecore"
  },
  "dependencies": {
    "@emfts/core": "^0.1.1-next.7",
    "@emfts/uimodel-composer": "^0.0.2-next.1",
    "@emfts/vue-registry": "^0.0.1-next.1",
    "primeicons": "^8.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eclipse-daanse/tsm": "^0.0.1-next.1",
    "@emfts/codegen": "^0.0.1-next.7",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.4"
  }
}
