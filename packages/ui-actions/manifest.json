{
  "id": "ui-actions",
  "name": "Action System",
  "version": "0.0.1",
  "description": "Configurable action framework with internal handlers and remote REST execution",
  "entry": "src/index.ts",
  "sharedDependencies": [
    { "id": "vue", "versionRange": "^3.5.0" },
    { "id": "primevue", "versionRange": "^4.5.0" },
    { "id": "@emfts/core", "versionRange": "^0.3.0-next.4" },
    { "id": "@eclipse-daanse/tsm", "versionRange": "^0.1.0-next.1" }
  ],
  "dependencies": ["ui-layout", "ui-perspectives"],
  "services": {
    "provides": [
      { "id": "gene.action.registry" },
      { "id": "gene.action.manager" },
      { "id": "gene.action.executor.internal" },
      { "id": "gene.action.executor.remote" },
      { "id": "gene.action.events" },
      { "id": "gene.jobs" },
      { "id": "gene.command.registry" },
      { "id": "gene.keybindings" }
    ],
    "requires": [
      { "id": "gene.eventbus" },
      { "id": "ui.registry.panels" }
    ]
  }
}
