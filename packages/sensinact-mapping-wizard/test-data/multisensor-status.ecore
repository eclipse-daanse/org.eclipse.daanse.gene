<?xml version="1.0" encoding="UTF-8"?>
<!-- Nachrichtentyp 2: Status-/Heartbeat-Uplink desselben Multisensors.
     Zusammen mit multisensor-measurement.ecore speist er über ein
     MappingProfile (providerStrategy=UNIFIED) denselben Provider/Zwilling. -->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="multisensorstatus" nsURI="https://example.org/demo/multisensor/status"
    nsPrefix="msstat">

  <eClassifiers xsi:type="ecore:EClass" name="StatusUplink"
      eSuperTypes="https://example.org/demo/multisensor/base#//BaseUplink">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="batteryVoltage"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Batteriespannung"/>
      </eAnnotations>
      <eAnnotations source="sensinact.mapping">
        <details key="sensinact.mapping.unit" value="V"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rssi"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="sensinact.mapping">
        <details key="sensinact.mapping.unit" value="dBm"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uptimeHours"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
      <eAnnotations source="sensinact.mapping">
        <details key="sensinact.mapping.unit" value="h"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="errorFlag"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="true, wenn das Gerät einen Fehlerzustand meldet"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firmwareVersion"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
</ecore:EPackage>
