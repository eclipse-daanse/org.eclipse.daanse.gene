{
  "name": "sensinact-mapping-wizard",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Assistent zum Erzeugen von SensiNact-ProviderMapping-XMIs aus Sensor-Ecore-Modellen",
  "scripts": {
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "generate": "emfts-codegen generate -m model/mapping-wizard.ecore -c model/mapping-wizard.genconfig.xmi",
    "build:plugin": "node scripts/build-plugin.mjs",
    "serve:plugin": "npx serve dist/plugins -l 5399 --cors",
    "sync:mapping-model": "cp ../../dim_xdp/event.atlas/org.eclipse.fennec.event.atlas.mapping/model/event-atlas-mapping.ecore src/assets/event-atlas-mapping.ecore",
    "mock:atlas": "node scripts/mock-atlas.mjs"
  },
  "dependencies": {
    "@emfts/core": "^0.2.0-next.2",
    "@emfts/uimodel-composer": "^0.0.2-next.1",
    "@emfts/vue-registry": "^0.0.1-next.1",
    "primeicons": "^8.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eclipse-daanse/tsm": "^0.0.1-next.1",
    "@emfts/codegen": "^0.0.1-next.7",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.4"
  },
  "license": "EPL-2.0"
}
