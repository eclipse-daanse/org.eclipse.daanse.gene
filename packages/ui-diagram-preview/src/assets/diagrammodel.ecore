<?xml version="1.0" encoding="UTF-8"?>
<!--
  Declarative diagram projection model — the model-driven analog of uimodel.ecore.
  A DiagramModel maps a domain model (any EMF model) to an ELK graph: which
  EClass becomes a node, which feature provides the label/rows, which reference
  pair becomes an edge. A generic interpreter executes this against a domain
  EObject at runtime (see src/diagram/interpret.ts) — no per-domain code.

  All *feature* references (labelFeature, detailFeature, from, sourcePath,
  targetPath, whenFeature, fromPath) are typed EReferences pointing into
  http://www.eclipse.org/emf/2002/Ecore — following the same pattern as
  uimodel.ecore (WidgetComponent.feature → EStructuralFeature, etc.).
  Ordered multi-valued references (upperBound="-1") represent traversal paths,
  e.g. fromPath = [Database.tables, Table.foreignKeys].
-->
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="diagrammodel" nsURI="http://diagrammodel/1.0" nsPrefix="diagrammodel">

  <eClassifiers xsi:type="ecore:EClass" name="DiagramModel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Typed reference to the root EClass of the domain model being visualised -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetClass"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="layoutOptions"
        upperBound="-1" eType="#//LayoutOption" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nodes"
        upperBound="-1" eType="#//NodeMapping" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="edges"
        upperBound="-1" eType="#//EdgeMapping" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="styles"
        upperBound="-1" eType="#//DiagramStyle" containment="true"/>
      <!-- Settings of the diagram, like the feature records of daanse: what is shown and how -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="switches" upperBound="-1"
        eType="#//Switch" containment="true"/>
    <!-- Named settings combinations (minimal, full, ...); the first is the default -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="presets" upperBound="-1"
        eType="#//Preset" containment="true"/>
      <!-- Which objects show this diagram, from which root, focused on which objects -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="bindings" upperBound="-1"
        eType="#//Binding" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="LayoutOption">
    <eAnnotations source="documentation">
      <details key="documentation" value="An ELK layout option, e.g. key='elk.algorithm' value='layered'."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="NodeMapping">
    <eAnnotations source="documentation">
      <details key="documentation" value="Projects each domain object reached by 'from' into a diagram node. 'from' is an ordered list of EReferences forming a path from the diagram root (e.g. [Database.tables])."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Optional stereotype/kind label shown above the node title, e.g. «Class» -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stereotype"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Optional small type-icon glyph rendered in the header next to the kind -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="icon"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Optional feature rendered as a small subtitle under the title (e.g. EPackage.nsURI) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="subtitleFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <!-- A "group" node has no domain object of its own: it is a synthetic visual
         bucket (e.g. DATATYPES) whose `children` are built from the PARENT object.
         groupLabel is the fixed header text. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="group"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="groupLabel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Optional metaclass filter: only objects whose eClass is exactly this
         EClass become nodes (discriminate e.g. EClass vs EEnum vs EDataType). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <!-- Optional filter: only domain objects for which this OCL/JS expression is
         true become nodes (enables type discrimination, e.g. self.abstract). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="condition"
        eType="#//Expression" containment="true"/>
    <!-- Ordered path of EReferences from the diagram root to the node instances -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="from"
        upperBound="-1" ordered="true"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <!-- Feature whose value is rendered as the node header label -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="labelFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="style"
        eType="#//DiagramStyle"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="compartments"
        upperBound="-1" eType="#//Compartment" containment="true"/>
    <!-- Nested node mappings rendered as children inside this (container) node;
         their 'from' path is relative to THIS node's domain object. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="children"
        upperBound="-1" eType="#//NodeMapping" containment="true"/>
      <!-- Only when this condition holds - typically a switch of the diagram -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="when"
        eType="#//Condition" containment="true"/>
    <!-- Declarative alternative to from: a query from the parent object -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rowsFrom"
        eType="#//Query" containment="true"/>
    <!-- Badges in the node header (TMP, SYS, abstract) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="headerBadges" upperBound="-1"
        eType="#//Badge" containment="true"/>
    <!-- Title in italics when this holds (abstract classes) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="italicWhen"
        eType="#//Condition" containment="true"/>
      <!-- ELK options for this node's own content when it is a container (direction, aspect ratio, spacing) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="layoutOptions" upperBound="-1"
        eType="#//LayoutOption" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Compartment">
    <eAnnotations source="documentation">
      <details key="documentation" value="A group of rows inside a node. 'from' is an ordered path of EReferences from the owning node object."/>
    </eAnnotations>
    <!-- Ordered path of EReferences from the node object to the row items -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="from"
        upperBound="-1" ordered="true"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <!-- Optional uppercase section header drawn above the rows (e.g. ATTRIBUTES) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="labelFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="detailFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separator"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Optional per-row filter: only row objects for which this expression is
         true are shown (e.g. only features that declare a default value). -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rowCondition"
        eType="#//Expression" containment="true"/>
    <!-- Optional boolean feature → leading key icon on the row (e.g. EAttribute.iD) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="keyFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <!-- Optional boolean feature → trailing edge marker: true = containment
         diamond (◆), false = navigable arrow (›). E.g. EReference.containment. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="markerFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <!-- Optional 3rd column: multiplicity rendered as "lower..upper" (-1 = *) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="lowerBoundFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="upperBoundFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <!-- Optional nested rows (e.g. operation parameters): subFrom is a path from
         the row object, subLabel/subDetail are read off each sub-row object. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="subFrom"
        upperBound="-1" ordered="true"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subLabelFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subDetailFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <!-- Optional metaclass filter for rows (e.g. only EAttribute, only EReference) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="badges"
        upperBound="-1" eType="#//Badge" containment="true"/>
      <!-- Only when this condition holds - typically a switch of the diagram -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="when"
        eType="#//Condition" containment="true"/>
    <!-- Section colour: tints the title band and the rows -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Declarative alternative to from: a query from the node object to the rows -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rowsFrom"
        eType="#//Query" containment="true"/>
    <!-- Declarative alternative to labelFeature -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="label"
        eType="#//Value" containment="true"/>
    <!-- Declarative alternative to detailFeature -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="detail"
        eType="#//Value" containment="true"/>
    <!-- Declarative row filter -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rowWhen"
        eType="#//Condition" containment="true"/>
    <!-- Leading icons of a row, each with its condition (PK, FK, parameter direction) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="icons" upperBound="-1"
        eType="#//RowIcon" containment="true"/>
      <!-- Connectors inside the node: from each row to the rows of the objects this query leads to (index row -> its column rows) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="links"
        eType="#//Query" containment="true"/>
      <!-- Declarative alternative to subFrom: the sub-rows of a row (an operation's parameters) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="subRowsFrom"
        eType="#//Query" containment="true"/>
      <!-- Declarative multiplicity of a row (e.g. a Value with multiplicity=true) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="multiplicityValue"
        eType="#//Value" containment="true"/>
    <!-- Declarative label of a sub-row -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="subLabel"
        eType="#//Value" containment="true"/>
    <!-- Declarative detail of a sub-row -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="subDetail"
        eType="#//Value" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Expression">
    <eAnnotations source="documentation">
      <details key="documentation" value="A boolean expression (OCL/JS) evaluated against a domain object, e.g. language='OCL' body='self.abstract = true'. Mirrors uimodel.ecore Expression."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="language"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="body"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Badge">
    <eAnnotations source="documentation">
      <details key="documentation" value="An icon shown on a row when 'whenFeature' is truthy, e.g. icon='PK' whenFeature=Column.primaryKey."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="icon"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- EStructuralFeature (typically EAttribute of EBoolean) evaluated for truthiness -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="whenFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
      <!-- Only when this condition holds - typically a switch of the diagram -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="when"
        eType="#//Condition" containment="true"/>
    <!-- Badge colour; default amber -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="EdgeMapping">
    <eAnnotations source="documentation">
      <details key="documentation" value="Projects domain objects into edges. fromPath navigates from the diagram root to the edge objects. sourcePath/targetPath navigate from the edge object to source/target node objects. All paths are ordered lists of EReferences."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Ordered path from diagram root to the objects that represent edges -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="fromPath"
        upperBound="-1" ordered="true"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <!-- Ordered path from the edge object to the source node objects -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourcePath"
        upperBound="-1" ordered="true"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <!-- Ordered path from the edge object to the target node objects -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetPath"
        upperBound="-1" ordered="true"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="labelFeature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Optional metaclass filter for edge objects (e.g. only EReference) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceCardinality"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetCardinality"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Optional per-end decoration overriding the kind-derived marker:
         NONE | OPEN_ARROW | TRIANGLE_HOLLOW | TRIANGLE_FILLED | DIAMOND_HOLLOW | DIAMOND_FILLED -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceDecoration"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetDecoration"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Only when this condition holds - typically a switch of the diagram -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="when"
        eType="#//Condition" containment="true"/>
    <!-- SOLID | DASHED; default by kind -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lineStyle"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The edge starts at the source node's row with this label among the rows showing the node's own
         object (e.g. a reference name listed in the node) - instead of at the node -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceRow"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Colour of the line and its arrow (CSS colour), e.g. one per kind of reference; empty = by kind -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Cardinality at the source end, computed (e.g. the multiplicity of an association end) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceCardinalityValue"
        eType="#//Value" containment="true"/>
    <!-- Cardinality at the target end, computed -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetCardinalityValue"
        eType="#//Value" containment="true"/>
      <!-- Declarative alternative to sourcePath, from the edge object -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceQuery"
        eType="#//Query" containment="true"/>
    <!-- Declarative alternative to targetPath, from the edge object -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetQuery"
        eType="#//Query" containment="true"/>
    <!-- Text at the source end (role name) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceLabelValue"
        eType="#//Value" containment="true"/>
    <!-- Text at the target end (role name) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetLabelValue"
        eType="#//Value" containment="true"/>
    <!-- Decoration of the source end, computed (aggregation literal mapped to DIAMOND_HOLLOW / DIAMOND_FILLED) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceDecorationValue"
        eType="#//Value" containment="true"/>
    <!-- Decoration of the target end, computed -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetDecorationValue"
        eType="#//Value" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DiagramStyle">
    <eAnnotations source="documentation">
      <details key="documentation" value="Visual style for nodes/edges."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="headerColor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="css"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Query">
    <eAnnotations source="documentation">
      <details key="documentation" value="A navigation from a start object: an ordered list of steps; every step maps each current object to zero or more objects."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="steps" upperBound="-1"
        eType="#//Step" containment="true"/>
      <!-- Further queries from the same start object; their results are added (partners via associations AND via generalizations) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="union" upperBound="-1"
        eType="#//Query" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Step">
    <eAnnotations source="documentation">
      <details key="documentation" value="One navigation step: follow 'feature' forward, or inverse (the objects whose 'feature' holds the current object, searched in the diagram's resource), or go to the container. 'filterClass' keeps only instances of that class or its subclasses."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inverse"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="container"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="filterClass"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
      <!-- Keep only the objects of this step for which the condition holds -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="where"
        eType="#//Condition" containment="true"/>
    <!-- Instead of a feature: the other objects in the same containment list as the current one (the other end of an association) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="siblings"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Keep only the n-th object of this step per current object (0-based; "last") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="index"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <!-- Instead of a feature: an ancestor whose class is filterClass - "nearest" or "outermost" -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ancestor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Condition">
    <eAnnotations source="documentation">
      <details key="documentation" value="A declarative condition on an object. kind: EXISTS (query not empty), EQUALS (feature at the query's end has the value or literal), SET (feature set), NOT / AND / OR (over operands), SWITCH (the diagram's switch has one of the values), EXPRESSION (escape hatch: 'expression')."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="query"
        eType="#//Query" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <!-- Value, literal or comma-separated switch values -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Switch name for kind SWITCH -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="switch"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="operands" upperBound="-1"
        eType="#//Condition" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="expression"
        eType="#//Expression" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Value">
    <eAnnotations source="documentation">
      <details key="documentation" value="A text read from an object: follow 'query', read 'feature' (a referenced object gives its name), join several results with ', '; 'multiplicity' reads a CWM-style multiplicity range as lower..upper; prefix/suffix wrap a non-empty text; 'text' is a fixed text."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="query"
        eType="#//Query" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="feature"
        eType="http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="prefix"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="suffix"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="multiplicity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Maps a literal to a text (pdk_in -> arrow) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="literalMap" upperBound="-1"
        eType="#//LiteralText" containment="true"/>
      <!-- Several values joined into one text (e.g. timing, event, orientation), with 'separator' (default a space) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="parts" upperBound="-1"
        eType="#//Value" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separator"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="upperCase"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <!-- Empty text unless this holds (e.g. a switch: column types on) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="when"
        eType="#//Condition" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LiteralText">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="literal"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RowIcon">
    <eAnnotations source="documentation">
      <details key="documentation" value="A leading icon of a row: PRIMARY_KEY, FOREIGN_KEY or a free glyph in 'glyph', shown when 'when' holds for the row object."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="glyph"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="when"
        eType="#//Condition" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Switch">
    <eAnnotations source="documentation">
      <details key="documentation" value="A diagram setting: kind BOOLEAN (values true/false) or CHOICE (values e.g. HIDDEN, INLINE, OBJECT, BOTH)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="values" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="defaultValue"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Preset">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="settings" upperBound="-1"
        eType="#//Setting" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Setting">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="switch"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Binding">
    <eAnnotations source="documentation">
      <details key="documentation" value="An object of exactly 'sourceClass' shows this diagram. 'root' leads from it to the diagram root (none: the object itself). 'focus' leads to the objects to show; without it everything under the root shows. With a focus only those objects and their containers become nodes, and only edges between shown objects are drawn. The object itself is the diagram's main object."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sourceClass"
        eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="root"
        eType="#//Query" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="focus"
        eType="#//Query" containment="true"/>
  </eClassifiers>
</ecore:EPackage>
