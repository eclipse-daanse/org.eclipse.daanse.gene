<?xml version="1.0" encoding="UTF-8"?>
<!--
  Diagram of a CWM Business Nomenclature (PH-10, FR-4.2), for the generic
  diagram interpreter of ui-diagram-preview. The mappings repeat per class
  and depth (the interpreter matches node classes exactly): what changes for
  one, changes for all.

  A business domain, taxonomy or glossary is drawn as a frame with its
  concepts and terms; nested taxonomies and glossaries are frames too (two
  levels). Edges: a term's meaning (Term → Concept), narrower and preferred
  terms, related terms and concepts (dashed) and a glossary's taxonomies.
  Concepts and terms list their references by name; each reference's edges
  start at its row, in one colour per kind of reference, and come into
  their target from above. A concept or term shows a focus diagram: itself
  with its neighbours, each in the frame of the collection it lies in.
-->
<diagrammodel:DiagramModel xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:diagrammodel="http://diagrammodel/1.0"
    name="CWM Nomenclature Diagram">
  <targetClass href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package"/>
  <layoutOptions key="elk.algorithm" value="org.eclipse.elk.layered"/>
  <layoutOptions key="elk.direction" value="DOWN"/>
  <layoutOptions key="elk.edgeRouting" value="ORTHOGONAL"/>
  <layoutOptions key="elk.layered.spacing.nodeNodeBetweenLayers" value="60"/>
  <layoutOptions key="elk.spacing.nodeNode" value="30"/>
  <layoutOptions key="elk.spacing.componentComponent" value="30"/>
  <layoutOptions key="elk.spacing.edgeNode" value="30"/>
  <layoutOptions key="gene.edgeEntry" value="top"/>
  <layoutOptions key="gene.liftEdges" value="true"/>
  <layoutOptions key="elk.padding" value="[top=20,left=20,bottom=20,right=20]"/>

  <switches name="meanings" label="Bedeutungen (Term → Concept)" kind="BOOLEAN" defaultValue="true"/>
  <switches name="narrower" label="Unterbegriffe" kind="BOOLEAN" defaultValue="true"/>
  <switches name="preferred" label="Bevorzugte Benennung" kind="BOOLEAN" defaultValue="true"/>
  <switches name="related" label="Verwandte" kind="BOOLEAN" defaultValue="true"/>
  <switches name="taxonomies" label="Taxonomien eines Glossars" kind="BOOLEAN" defaultValue="true"/>

  <presets name="full" label="Voll">
    <settings switch="meanings" value="true"/>
    <settings switch="narrower" value="true"/>
    <settings switch="preferred" value="true"/>
    <settings switch="related" value="true"/>
    <settings switch="taxonomies" value="true"/>
  </presets>
  <presets name="hierarchy" label="Nur Begriffshierarchie">
    <settings switch="meanings" value="true"/>
    <settings switch="narrower" value="true"/>
    <settings switch="preferred" value="false"/>
    <settings switch="related" value="false"/>
    <settings switch="taxonomies" value="false"/>
  </presets>

  <styles xmi:id="domainStyle" name="domain" headerColor="#334155"/>
  <styles xmi:id="taxonomyStyle" name="taxonomy" headerColor="#0f766e"/>
  <styles xmi:id="glossaryStyle" name="glossary" headerColor="#7c3aed"/>
  <styles xmi:id="conceptStyle" name="concept" headerColor="#1e40af"/>
  <styles xmi:id="termStyle" name="term" headerColor="#b45309"/>

  <bindings>
    <sourceClass href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//BusinessDomain"/>
  </bindings>
  <bindings>
    <sourceClass href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Taxonomy"/>
  </bindings>
  <bindings>
    <sourceClass href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Glossary"/>
  </bindings>
  <bindings>
    <sourceClass href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Concept"/>
    <root>
      <steps ancestor="nearest">
        <filterClass href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package"/>
      </steps>
    </root>
    <focus>
      <union/>
      <union>
        <steps>
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Concept/relatedConcept"/>
        </steps>
      </union>
      <union>
        <steps inverse="true">
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Concept/relatedConcept"/>
        </steps>
      </union>
      <union>
        <steps inverse="true">
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/concept"/>
        </steps>
      </union>
    </focus>
  </bindings>
  <bindings>
    <sourceClass href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term"/>
    <root>
      <steps ancestor="nearest">
        <filterClass href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//Package"/>
      </steps>
    </root>
    <focus>
      <union/>
      <union>
        <steps>
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/concept"/>
        </steps>
      </union>
      <union>
        <steps>
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/narrowerTerm"/>
        </steps>
      </union>
      <union>
        <steps inverse="true">
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/narrowerTerm"/>
        </steps>
      </union>
      <union>
        <steps>
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/relatedTerm"/>
        </steps>
      </union>
      <union>
        <steps inverse="true">
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/relatedTerm"/>
        </steps>
      </union>
      <union>
        <steps>
          <feature href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//Term/preferredTerm"/>
        </steps>
      </union>
    </focus>
  </bindings>

  <nodes name="BusinessDomainNode0" stereotype="BusinessDomain" icon="▤">
    <style href="#domainStyle"/>
    <sourceClass href="http://www.omg.org/spec/CWM/1.1/analysis/businessnomenclature#//BusinessDomain"/>
    <labelFeature href="http://www.omg.org/spec/CWM/1.1/objectmodel/core#//ModelElement/name"/>
    <layoutOptions key="elk.algorithm" value="org.eclipse.elk.layered"/>
    <layoutOptions key="elk.direction" value="DOWN"/>
    <layoutOptions key="elk.edgeRouting" value="ORTHOGONAL"/>
    <layoutOptions key="elk.spacing.nodeNode" value="30"/>
    <layoutOptions key="elk.layered.spacing.nodeNodeBetweenLayers" value="40"/>
    <layoutOptions key="elk.spacing.componentComponent" value="30"/>
    <layoutOptions key="elk.spacing.edgeNode" value="30"/>
    <layoutOptions key="elk.padding" value="[top=75,left=50,bottom=15,right=50]"/>
    <children name="ConceptNode1" stereotype="Concept" icon="●">
