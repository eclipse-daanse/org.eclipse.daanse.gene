    },
    {
      "id": "@emfts/core",
      "versionRange": ">=0.1.0"
    },
    {
      "id": "@emfts/vue-registry",
      "versionRange": ">=0.0.1"
    },
    {
      "id": "@emfts/uimodel-composer",
      "versionRange": ">=0.0.1"
    }
  ],
