<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="dataatlaswizard" nsURI="http://fennec/data/atlas/data-atlas-wizard/1.0"
    nsPrefix="dataatlaswizard">

  <!-- Fassadenmodell des Data-Atlas-Assistenten: die Entscheidungen des
       Nutzers in Fachsprache. Ein Transformer erzeugt daraus die konforme
       DataAtlasConfiguration (configuration.ecore, nsURI
       https://eclipse.org/fennec/data/atlas/configuration/1.0.0).

       Die Fassade vereinfacht bewusst: ein Service und
       inputType = outputType. Siehe Plan
       docs/plans/data-atlas-wizard.md, Abschnitt 1.

       Verweise auf Modellklassen entstehen immer über den nsURI. Relative
       Datei-Verweise wären eine Deployment-Konvention, die keine der drei
       beteiligten Anwendungen kennt — gene hat kein Dateisystem, der Model
       Atlas liefert Objekte statt Pfade. Wer sie wirklich braucht, schreibt
       das XMI von Hand. -->

  <eClassifiers xsi:type="ecore:EClass" name="AtlasSetup">
    <!-- Identität der Instanz (= DataAtlasConfiguration.name/description). -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="instanceName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="instanceDescription"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>

    <!-- Das Domänenmodell, aus dem die Datensätze abgeleitet werden. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="modelPackage" lowerBound="1"
        eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage"/>

    <!--
      Die Datenwege. Ein Weg ist eine Kette: eine Quelle, die Klassen, die aus
      ihr veröffentlicht werden, und die Formate dafür. Die Verschachtelung
      drückt die Zugehörigkeit aus, statt sie über id-Felder herzustellen.

      Das Zielmodell führt stattdessen Register (alles einmal definiert, oft
      referenziert) — der Transformer flacht die Ketten beim Schreiben wieder
      dahin aus.
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="chains" upperBound="-1"
        eType="#//DataChain" containment="true"/>

    <!-- Identität des REST-Endpunkts (= RestDataService). Die Felder liegen
         flach am Setup, weil die Fassade genau einen Service kennt. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serviceId" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serviceName" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="serviceDescription" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="urlContext" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="openApi" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false"/>
    <!-- Pagination-Parameter: Der Transformer schreibt sie nur, wenn sie von
         diesen Vorgaben abweichen. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paginationOffsetParameterName"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="offset"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paginationSizeParameterName"
        lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral="limit"/>
  </eClassifiers>

  <!--
    Ein Datenweg: woher, was, in welchen Formaten.

    Die Quelle gehört entweder der Kette (`source`) oder sie teilt sich die
    einer anderen (`sharedSource`) — genau eines von beidem. Geteilt heißt im
    Ergebnis: ein einziger DataInput, von mehreren Wegen benutzt.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="DataChain">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="source"
        eType="#//DataSourceConfig" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sharedSource"
        eType="#//DataSourceConfig"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="datasets" upperBound="-1"
        eType="#//DatasetConfig" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="exports" upperBound="-1"
        eType="#//ExportConfig" containment="true"/>
  </eClassifiers>

  <!--
    Ein Dateneingang. Eine Klasse mit `kind` statt abstrakter Subklassen: so
    kann `visibilityCondition` im UIModel direkt darauf prüfen, und die Liste
    bleibt homogen.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="DataSourceConfig">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
        eType="#//InputKind" defaultValueLiteral="FILE"/>

    <!-- kind = FILE: absoluter Pfad der Datendatei im Container. Relativ geht
         nicht, die Konfiguration kommt über HTTP aus dem Model Atlas. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fileUri"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>

    <!-- kind = DATABASE: die JdbcDataSource und das JPA-Mapping. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dataSourceId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dataSourceName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- LDAP-Filter, z. B. (dataSourceName=personsDs) -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dataSourceFilter"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mappingKind" lowerBound="1"
        eType="#//MappingKind" defaultValueLiteral="DERIVED"/>
    <!-- Bei IMPORTED: das eorm-Dokument als Rohtext, wie es der eorm-Wizard
         oder der Model Atlas liefert. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="eormXmi"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Eine Klasse, die als Datensatz veröffentlicht wird (= DataSet +
       RestDataServiceConfiguration). -->
  <eClassifiers xsi:type="ecore:EClass" name="DatasetConfig">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="selected"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <!-- Nicht "eClass" nennen: der Name kollidiert mit EObject.eClass() und
         die generierte Impl liesse sich nicht mehr uebersetzen. Der
         eorm-Wizard nennt dasselbe Feld ebenfalls targetClass. -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetClass" lowerBound="1"
        eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="path" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- EInt statt EBigInteger: der Transformer schreibt den Dezimalstring.
         -1 bedeutet „nicht gesetzt" und wird nicht geschrieben. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="batchSize"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="batchSizeLimit"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="-1"/>
  </eClassifiers>

  <!-- Ein Ausgabeformat (= DistributionExport bzw. CSVDistributionExport). -->
  <eClassifiers xsi:type="ecore:EClass" name="ExportConfig">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="selected"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="kind" lowerBound="1"
        eType="#//ExportKind" defaultValueLiteral="JSON"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Nur für CSV/CSV_ZIP relevant. -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="separator"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        defaultValueLiteral=";"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="includeTypeHeader"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="InputKind">
    <eLiterals name="FILE" value="0"/>
    <eLiterals name="DATABASE" value="1"/>
  </eClassifiers>

  <!-- DERIVED: der Data Atlas leitet das JPA-Mapping aus dem Modell ab.
       IMPORTED: ein fertiges eorm-Dokument wird eingebettet. -->
  <eClassifiers xsi:type="ecore:EEnum" name="MappingKind">
    <eLiterals name="DERIVED" value="0"/>
    <eLiterals name="IMPORTED" value="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ExportKind">
    <eLiterals name="JSON" value="0"/>
    <eLiterals name="XML" value="1"/>
    <eLiterals name="CSV" value="2"/>
    <eLiterals name="CSV_ZIP" value="3"/>
  </eClassifiers>

</ecore:EPackage>
