<?xml version="1.0" encoding="UTF-8"?>
<!-- Postgres + CSV example: the persons live in a relational database, reached
     through a JPADataInput over a JdbcDataSource, and the DataSet is served as
     CSV (semicolon separated, no SQL-type row) as well as JSON.

     The JdbcDataSource filter selects the javax.sql.DataSource service the
     deployment provides. In the compose setup that service comes from
     org.eclipse.daanse.jdbc.datasource.postgresql, configured by
     dataatlas/load/datasource.json, which carries the extra config key
     dataSourceName=personsDs - every non-dot key of a daanse DataSource
     configuration also becomes a service property, which is what makes it
     selectable here.

     Atlas-mode variant: EClass references are nsURI-based hrefs, resolved
     against the Model Atlas schema registry instead of local ecore files.
     dataatlas-postgres.xmi is the file-mode twin. -->
<configuration:DataAtlasConfiguration xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:configuration="https://eclipse.org/fennec/data/atlas/configuration/1.0.0"
    name="example-postgres-atlas" description="Example Data Atlas instance serving a PostgreSQL table as CSV, delivered by a Model Atlas.">
  <dataSources id="persons-db" name="Persons DB" filter="(dataSourceName=personsDs)"/>
  <dataInputs xsi:type="configuration:JPADataInput" id="persons-jpa" dataSource="persons-db">
    <supportedEClasses href="https://eclipse.org/fennec/data/atlas/example/person/1.0.0#//Person"/>
  </dataInputs>
  <dataSets id="persons" name="Persons" description="All persons from the database, as CSV or JSON."
      dataInput="persons-jpa" distributionExport="csv json">
    <inputType href="https://eclipse.org/fennec/data/atlas/example/person/1.0.0#//Person"/>
    <outputType href="https://eclipse.org/fennec/data/atlas/example/person/1.0.0#//Person"/>
  </dataSets>
  <services xsi:type="configuration:RestDataService" id="persons-pg-rest" name="Persons Postgres REST"
      description="REST endpoint publishing the database-backed persons." urlContext="/pg" openAPI="false"
      publication="open-data">
    <configuration id="persons-pg-rest-config" dataSet="persons" path="persons"/>
  </services>
  <exports xsi:type="configuration:CSVDistributionExport" id="csv" name="CSV"
      description="Semicolon separated, no SQL-type row." separator=";" includeTypeHeader="false"/>
  <exports id="json" name="JSON" description="Plain JSON, kept alongside the CSV export." mediaType="application/json"/>
  <publications id="open-data" catalog="example" publisherName="Eclipse Fennec Data Atlas example"
      licenseUri="http://dcat-ap.de/def/licenses/dl-by-de/2.0">
    <keywords>persons</keywords>
    <keywords>postgres</keywords>
  </publications>
</configuration:DataAtlasConfiguration>
