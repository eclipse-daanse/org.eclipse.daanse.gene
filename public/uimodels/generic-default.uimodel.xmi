<?xml version="1.0" encoding="UTF-8"?>
<!--
  App-Default: generisches Property-Layout fuer ALLE Klassen (keine
  targetClasses). Struktur wie autorierte Modelle: FormView je Sektion
  (group = Ueberschrift, gerendert vom Konsumenten), darin AllFeatures
  als fields-Platzhalter (emf.ts.ui #2/#4).

  Widget-Typ-Wahl (emf.ts.ui #5): explizite TemplateCase-Fallliste je
  Platzhalter — erster Treffer gewinnt, letzter Fall ohne when ist der
  Default. Die Prototypen stehen einmal im templates-Katalog und werden
  per Referenz wiederverwendet; ein implizites Code-Mapping gibt es
  nicht mehr.

  Bewusste Abweichung vom upstream-Beispiel: KEIN Identification-Block —
  das iD-Attribut erscheint wie im bisherigen gene-Layout unter Attributes;
  die XMI-ID/Primary-Key-Zeile rendert der Panel-Rahmen (Pixel-Paritaet
  mit e2e/properties-baseline.spec.ts).

  filter/when: JS-Metaausdruecke, self = EStructuralFeature (Meta-Ebene,
  Method-Call-Stil: nur das Wurzelobjekt ist geproxied).
  Label-Konvention (emf.ts.ui#3): EAnnotation am Feature
  (source http://uimodel/1.0, key label) uebersteuert die Namens-
  Ableitung; ohne Annotation greift fail-open die Ableitung.
-->
<uimodel:UIModel
    xmlns:xmi="http://www.omg.org/XMI"
    xmi:version="2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:uimodel="http://uimodel/1.0"
    name="gene-generic-default">

  <!-- Prototypen-Katalog: einmal definiert, von allen Cases referenziert -->
  <templates xsi:type="uimodel:CheckboxWidget"      xmi:id="t-checkbox"  name="checkbox"/>
  <templates xsi:type="uimodel:NumberWidget"        xmi:id="t-number"    name="number"/>
  <templates xsi:type="uimodel:DateWidget"          xmi:id="t-date"      name="date"/>
  <templates xsi:type="uimodel:SelectWidget"        xmi:id="t-select"    name="select"/>
  <templates xsi:type="uimodel:ReferenceLinkWidget" xmi:id="t-reference" name="reference"/>
  <templates xsi:type="uimodel:InputWidget"         xmi:id="t-input"     name="input"/>

  <components xsi:type="uimodel:FormView" name="attributes" group="Attributes">
    <fields xsi:type="uimodel:AllFeatures" name="all-attributes">
      <filter language="JS"
          body="self.eClass().getName() === 'EAttribute' &amp;&amp; !self.derived &amp;&amp; !self.transient"/>
      <bindings property="label">
        <expression language="JS"
            body="feature.getEAnnotation('http://uimodel/1.0')?.getDetails()?.getByKey('label')"/>
      </bindings>
      <cases widget="#t-checkbox">
        <when language="JS" body="['EBoolean','EBooleanObject'].includes(self.getEType()?.getName())"/>
      </cases>
      <cases widget="#t-number">
        <when language="JS"
            body="['EInt','EIntegerObject','ELong','ELongObject','EShort','EShortObject','EFloat','EFloatObject','EDouble','EDoubleObject','EBigDecimal','EBigInteger','EByte'].includes(self.getEType()?.getName())"/>
      </cases>
      <cases widget="#t-date">
        <when language="JS" body="self.getEType()?.getName() === 'EDate'"/>
      </cases>
      <cases widget="#t-select">
        <when language="JS" body="self.getEType()?.eClass().getName() === 'EEnum'"/>
      </cases>
      <cases widget="#t-input"/>   <!-- Default-Fall, explizit -->
    </fields>
  </components>

  <components xsi:type="uimodel:FormView" name="references" group="References">
    <fields xsi:type="uimodel:AllFeatures" name="all-references">
      <filter language="JS"
          body="self.eClass().getName() === 'EReference' &amp;&amp; !self.derived &amp;&amp; !self.transient"/>
      <bindings property="label">
        <expression language="JS"
            body="feature.getEAnnotation('http://uimodel/1.0')?.getDetails()?.getByKey('label')"/>
      </bindings>
      <cases widget="#t-reference"/>
    </fields>
  </components>

  <components xsi:type="uimodel:FormView" name="derived" group="Derived Values">
    <fields xsi:type="uimodel:AllFeatures" name="all-derived">
      <filter language="JS" body="self.derived === true"/>
      <bindings property="label">
        <expression language="JS"
            body="feature.getEAnnotation('http://uimodel/1.0')?.getDetails()?.getByKey('label')"/>
      </bindings>
      <!-- Widget-Typ hier nur formal: derived Features rendert die
           WidgetBridge ohnehin als read-only DerivedField -->
      <cases widget="#t-input"/>
    </fields>
  </components>
</uimodel:UIModel>
